# NBA選手名鑑 — 環境変数の雛形
#
# 使い方: このファイルを `.env.local` にコピーして値を埋めてください。
#   cp .env.example .env.local
# `.env.local` は .gitignore 済みです。**実際のキーをこのファイルに書かないでください。**
#
# 開発方針オーバーライド v3 §0.1「仮枠を作らない」に従い、
# 9/1 に実装しない機能の分も含めて、必要になる環境変数をここで先に確定させています。
# 各行の [W?-?] は ROADMAP.md のどのタスクで実際に使い始めるかを示します。

# ---------------------------------------------------------------------------
# サイト全体
# ---------------------------------------------------------------------------
# 公開URL（canonical・sitemap・robots の生成に使用）。ローカルでは http://localhost:3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Supabase / PostgreSQL  [W0-2 で発行 → W1-5 以降で使用]
# ---------------------------------------------------------------------------
# Supabase ダッシュボード > Project Settings > API から取得します。
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# service role キーはRLSを迂回できる管理者キーです。
# **サーバー側でのみ使用し、NEXT_PUBLIC_ を付けないでください（付けるとブラウザに露出します）。**
SUPABASE_SERVICE_ROLE_KEY=""

# マイグレーション適用・型生成に使う直接接続文字列
# Supabase ダッシュボード > Project Settings > Database > Connection string
DATABASE_URL=""

# ---------------------------------------------------------------------------
# データプロバイダ  [W1-9 で骨格 / W4-1 以降で本接続]
# ---------------------------------------------------------------------------
# 使用するProvider Adapterの選択。seed = DB投入済みのseedのみを使う（API未接続でも動作）
# 選択肢: seed | balldontlie
DATA_PROVIDER="seed"

BALLDONTLIE_API_KEY=""

# 【重要】外部APIから取得したデータを自社DBへ永続保存してよいかの許諾フラグ。
# W0-1（契約条件の書面確認）で「自社DB保存可」の回答が取れるまで false のままにしてください。
# W1-9 の起動時ガードがこの値を見て、false のときは外部Providerからの永続保存を停止します。
PROVIDER_PERSISTENCE_ALLOWED="false"

# ---------------------------------------------------------------------------
# 管理画面  [W3-1 で使用]
# ---------------------------------------------------------------------------
# 管理画面のBasic認証。公開前に必ず推測されない値へ変更してください。
ADMIN_BASIC_AUTH_USER=""
ADMIN_BASIC_AUTH_PASSWORD=""
